{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "precheck-",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/inject-context.py\""
          }
        ]
      },
      {
        "matcher": "precheck-scout",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/inject-codex.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/inject-synthesis.py\""
          }
        ]
      }
    ]
  }
}
